def encode_tex_file(file_path):
    """将 TEX 源文件和 cls 模板打包并 Base64 编码，用于 Overleaf 导入"""
    try:
        current_loc = os.path.dirname(__file__)
        # 构建需要打包的文件列表：生成的 tex 文件 + 模板 cls 文件
        file_paths = [
            file_path.replace('.pdf', '.tex'),
            os.path.join(current_loc, 'zlm', 'templates', 'resume.cls')
        ]
        zip_file_path = file_path.replace('.pdf', '.zip')

        # 创建 ZIP 文件
        with zipfile.ZipFile(zip_file_path, 'w') as zipf:
            for f_path in file_paths:
                if os.path.exists(f_path):
                    # 写入文件，只保留文件名以便在 Overleaf 根目录显示
                    zipf.write(f_path, os.path.basename(f_path))
                else:
                    print(f"警告：文件未找到，跳过打包：{f_path}")

        # 读取并编码
        with open(zip_file_path, 'rb') as zip_file:
            zip_content = zip_file.read()

        encoded_zip = base64.b64encode(zip_content).decode('utf-8')
        return encoded_zip

    except Exception as e:
        st.error(f"打包文件时发生错误：{e}")
        print(e)
        return None

