                        elif metric == "cosine_similarity":
                            title = "语义相似度 (Latent Space)"
                            help_text = "基于词语背后的深层含义进行比较，而非仅仅看字面。就像比较两道菜的“风味”而不是“配料表”。在这个空间中，意思相近的词（如 'innovate' 和 'create'）距离很近。这能反映 AI 是否真正理解了职位的核心需求，即使使用的措辞不同。"

                        st.markdown(f"**{title}**", help=help_text)
                        col_m_1, col_m_2, col_m_3 = st.columns(3)

                        col_m_1.metric(
                            label=":green[个人特色保留度]",
                            value=f"{user_personalization:.3f}",
                            delta="新简历 vs 原始简历",
                            delta_color="off"
                        )
                        col_m_2.metric(
                            label=":blue[人岗匹配度]",
                            value=f"{job_alignment:.3f}",
                            delta="新简历 vs 职位要求",
                            delta_color="normal" # 越高越好
                        )
                        col_m_3.metric(
                            label=":violet[原始匹配度]",
                            value=f"{job_match:.3f}",
                            delta="原始简历 vs 职位要求",
                            delta_color="inverse" # 用于对比提升
                        )
                    st.markdown("---")

            # D. 生成求职信
            if get_cover_letter_button:
                with st.status("✍️ 正在撰写求职信...", expanded=True) as status_cv:
                    cv_details, cv_path = resume_llm.cover_letter_generator(job_details, user_data, is_st=True)
                    if cv_path:
                        status_cv.update(label="✅ 求职信生成完毕", state="complete", expanded=False)

                if cv_path:
                    cv_col_1, cv_col_2 = st.columns([0.7, 0.3])
                    with cv_col_1:
                        st.subheader("✉️ 生成的求职信")
                        # 显示文本内容 (假设 cv_details 是 markdown 文本)
                        st.markdown(cv_details, unsafe_allow_html=True)
                    with cv_col_2:
                        cv_data = read_file(cv_path, "rb")
                        st.download_button(
                            label="⬇️ 下载 PDF 求职信",
                            data=cv_data,
                            file_name=os.path.basename(cv_path),
                            key="download_cv_button",
                            mime="application/pdf",
                            use_container_width=True
                        )
                    st.markdown("---")
                    st.toast("求职信生成成功！", icon="✅")

            # 完成提示
            st.toast("🎉 全部任务完成！", icon="👍")
            st.success("生成过程顺利结束", icon="✅")
            st.balloons()

            refresh = st.button("🔄 重新开始 / 清空缓存")
            if refresh:
                st.cache_resource.clear()
                st.cache_data.clear()
                st.rerun()

except Exception as e:
    st.error(f"💥 系统发生严重错误：{e}")
    st.markdown("""
    ### 建议操作：
    1. 检查 API Key 是否正确。
    2. 确认网络连接正常。
    3. 查看下方终端日志获取详细报错信息。
    """)
    st.stop()

st.link_button("💬 反馈问题、建议或参与贡献", "https://github.com/Ztrimus/job-llm/issues", use_container_width=True)